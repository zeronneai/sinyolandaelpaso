# Copia este archivo a .env.local para desarrollo. En Vercel van en
# Settings > Environment Variables.

# Supabase (Project Settings > API). Sin estas dos, la plataforma corre en
# modo local: solo se sincroniza entre pestañas del mismo navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Banner "MODO DEMO · pagos simulados" y herramientas de demo en el admin.
VITE_DEMO_MODE=true

# PIN del admin (en demo se muestra en la pantalla de acceso).
VITE_ADMIN_PIN=2468

# Proveedor de pagos: simulado | stripe
VITE_PAGOS=simulado

# Web App de Apps Script para los correos (opcional).
VITE_APPS_SCRIPT_URL=

# ---- Solo servidor (funciones /api de Vercel, nunca con prefijo VITE_) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://sinyolandaelpaso.com
